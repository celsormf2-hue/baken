{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "excludeFiles": "{img/**,video/**,docs/**,backup_site_antigo/**,private-data/**,scripts/**,.agents/**}"
    }
  },
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/(sobre|servicos|obras|contato)", "dest": "/$1.html" },
    { "src": "/(sobre|servicos|obras|contato|portal-cliente)\\.html", "status": 301, "headers": { "Location": "/$1" } },
    { "src": "/((?:portal-cliente|admin)(?:/.*)?|send-mail\\.php|sair)", "dest": "/api/index.php?route=$1" },
    { "src": "/(.*\\.php)", "dest": "/api/index.php?route=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php?route=$1" }
  ]
}
