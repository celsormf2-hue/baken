{
  "cleanUrls": true,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/portal-cliente(?:/.*)?", "dest": "/api/index.php" },
    { "src": "/admin(?:/.*)?", "dest": "/api/index.php" },
    { "src": "/sair", "dest": "/api/index.php" },
    { "src": "/(.*\\.php)", "dest": "/api/index.php" }
  ]
}
